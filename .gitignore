output.jsonl
*-session-output.md
*_session_output.md
*-session-output.jsonl
*_session_output.json
*-session-output.json
/docs/database/

# MemPalace (mempalace.yaml is tracked — id-411 {411.1d}; the rest is ignored)
# The rooms config is an authored design artefact, not machine-local state: it
# encodes DR-113/DR-114/DR-116 and the measured router mechanics in comments,
# and the docs-site equivalent has always been tracked. It can never pollute the
# palace either way — `mempalace.yaml` and `entities.json` are both in the
# miner's SKIP_FILENAMES, so neither is ever mined.
entities.json

# GitNexus (CLAUDE.md is tracked; the rest of the directory is ignored)
.gitnexus/**
!.gitnexus/CLAUDE.md

# AST Dataflow (CLAUDE.md is tracked; the rest of the directory is ignored)
.ast-dataflow/**
!.ast-dataflow/CLAUDE.md
# CocoIndex Code (ccc)
/.cocoindex_code/

lib/branding/client-branding-map.generated.ts
.type-drift-report.md

# OPS-T1 codemod dry-run / needs-manual reports — regenerable via
# scripts/codemods/wrap-define-route.ts (override dir via CODEMOD_OUTPUT_DIR)
docs/generated/

# ID-95 PI-18 {95.13}
# DSNs
scripts/.propagation-catalog.json

# Local session ephemera (Lavish review artifacts, user scratch dir)
.lavish/
.user-scratch/

# Client branding overlay (ID-68.22): deploy-time fetch output is never
# re-committed to the public tree. default.json is the only tracked client
# config; private client JSON + assets land here at build via
# scripts/fetch-client-branding.ts (ID-95) and must stay untracked.
/lib/branding/clients/*.json
!/lib/branding/clients/default.json
/public/clients/*

# jscpd raw report + parser output are regenerable via: bun run dupe-check;
# the *.md analysis files (AUDIT-REPORT + per-area audits) are the tracked deliverable.
docs/reports/jscpd-report/*.json
docs/reports/jscpd-report/parse-analysis.py

# design-sync (claude.ai/design import) — staged scripts, build output, machine state
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# MemTrace Code Intelligence
.memdb/
.memtrace/
.claude/skills/memtrace-*/

.warp/

.claude/skills/gitnexus/
