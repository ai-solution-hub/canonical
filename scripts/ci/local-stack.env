# scripts/ci/local-stack.env — the local Supabase stack's connection constants
# for CI E2E lanes ({365.5} / DR-096 cutover).
#
# These are the Supabase CLI's PUBLIC local-development demo credentials — the
# same on every machine and every CI runner (legacy demo JWTs signed with the
# fixed demo secret "super-secret-jwt-token-with-at-least-32-characters-long").
# They are NOT secrets and grant access only to a stack on that runner's own
# loopback. Verified against CLI 2.109.1 (`supabase status -o json`,
# 2026-07-26).
#
# WHY THE LEGACY JWTs AND NOT THE NEW-STYLE KEYS: `supabase status` also emits
# `sb_publishable_...` / `sb_secret_...` values, but their cross-machine
# determinism is unproven, and the build job bakes these values into the
# client bundle BEFORE any stack exists (NEXT_PUBLIC_* is inlined at build
# time), so every shard's stack must agree with the baked values. The legacy
# demo JWTs are deterministic by construction. Each CI shard asserts the
# running stack agrees with this file before tests run — if a CLI version bump
# ever changes the demo credentials, that assert fails loud instead of specs
# failing with unexplained 401s.
#
# Consumed by: .github/workflows/e2e-nightly.yml + ci.yml (e2e-smoke) via
#   grep -vE '^(#|$)' scripts/ci/local-stack.env >> "$GITHUB_ENV"
#
# POSTGRES_PASSWORD is the local stack's fixed DB password ("postgres" — see
# DB_URL in `supabase status`); lib/env-server.ts requires the var at boot.
SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
POSTGRES_PASSWORD=postgres
