{
  "compilerOptions": {
    "target": "ES2018",
    "lib": ["dom", "dom.iterable", "esnext"],
    // Pin auto-included ambient-global type packages. Without this, TS
    // auto-includes EVERY @types/* package in node_modules — which is how
    // @types/bun (bun-types) leaks its DOM-global overrides (e.g. a Bun-shaped
    // `fetch`) into the whole app + test compilation and breaks ~120 unrelated
    // files. The Bun globals the standalone `scripts/*.ts` CLIs need are
    // provided by the minimal hand-written shim `scripts/bun-ambient.d.ts`
    // (only the touched surface: Bun.file().textSync(), Bun.stdin.stream(),
    // import.meta.dir), which the CI typecheck (tsconfig.ci.json) picks up via
    // its **/*.ts glob once scripts/ is un-excluded. The full @types/bun is
    // deliberately NOT in this `types` list — it is retained as a dev-dep only
    // for bun-runtime resolution, never added to a `types` array (doing so
    // re-introduces the DOM-global leak). Non-ambient @types (turndown,
    // pluralize, uuid, etc.) are reached through explicit imports and are
    // unaffected by this list. (bl-213)
    "types": ["node", "react", "react-dom"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    // Type-aware backstop for the CodeQL return-style class (js/implicit-return,
    // js/mixed-returns): flags functions where some code paths return a value and
    // others fall through. Not part of `strict`. (ID-121.7 Wave C, theme-14.)
    "noImplicitReturns": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  // The `.next-1`..`.next-4` entries are the FIXED slot names for concurrent
  // dev servers sharing one checkout (NEXT_DIST_DIR — see next.config.ts).
  // Next matches these include strings LITERALLY: start a dev server with any
  // dist dir not listed here and it rewrites AND reformats this file, dirtying
  // the tree for every parallel session. A glob (`.next-*/types/**/*.ts`) does
  // NOT satisfy the check — verified. So agents pick a slot from this list
  // rather than inventing a name; four covers realistic parallelism.
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-1/types/**/*.ts",
    ".next-1/dev/types/**/*.ts",
    ".next-2/types/**/*.ts",
    ".next-2/dev/types/**/*.ts",
    ".next-3/types/**/*.ts",
    ".next-3/dev/types/**/*.ts",
    ".next-4/types/**/*.ts",
    ".next-4/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "scripts", "supabase", "mcp-apps", "docs-site", "vitest.integration.config.ts"]
}
